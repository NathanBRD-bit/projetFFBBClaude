# Copier en `.env` et renseigner les valeurs. Ne jamais commiter `.env`.
# Les mêmes clés doivent être déclarées dans le dashboard Vercel (Settings > Environment Variables).

# Base de données Postgres (Neon), utilisée par Drizzle ORM.
# Chaîne de connexion complète, fournie par le dashboard Neon. Exemple :
# postgresql://utilisateur:motdepasse@hote.neon.tech/base?sslmode=require
DATABASE_URL=

# Secret partagé protégeant les routes de tâches planifiées (Vercel Cron).
# Vercel envoie `Authorization: Bearer <CRON_SECRET>` ; la route refuse tout le reste.
# Générer une valeur aléatoire longue, propre à chaque environnement.
CRON_SECRET=

# Jeton de lecture/écriture Vercel Blob, pour le stockage des fichiers (photos, documents).
# Fourni par Vercel à la création du store Blob.
BLOB_READ_WRITE_TOKEN=

# URL publique du site, avec le protocole et sans barre oblique finale.
# Sert aux URL absolues (métadonnées, sitemap, liens dans les e-mails).
# En local : http://localhost:3000
URL_SITE=
